{
	"description": "Iceberg filesystem catalog (CATALOG_TYPE 'filesystem'): a directory tree in the layout of the Hadoop catalog, without a catalog service. DuckDB writes the table metadata files and version hints itself. Requires no service or network.",
	"on_init": "ATTACH '{TEMP_DIR}/iceberg_filesystem_warehouse' AS my_datalake (TYPE ICEBERG, CATALOG_TYPE 'filesystem'); CREATE SCHEMA IF NOT EXISTS my_datalake.default;",
	"statically_loaded_extensions": [
		"core_functions",
		"parquet",
		"avro",
		"iceberg",
		"httpfs",
		"icu"
	],
	"skip_error_messages": [],
	"test_env": [
		{
			"env_name": "CATALOG_TEST_CONFIG_SETUP",
			"env_value": "filesystem"
		},
		{
			"env_name": "STAGED_CREATE_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "FORMAT_V3_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "COLUMN_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "UNKNOWN_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "VARIANT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "GEOMETRY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMP_NS_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMP_NS_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMESTAMPTZ_NS_DEFAULT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "FILE_CLEANUP_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "CASE_SENSITIVE_TABLE_NAMES_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "SNAPSHOT_HISTORY_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "METADATA_FILE_READ_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "METADATA_LOG_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "TIMETRAVEL_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "ATOMIC_COMMIT_CONFLICT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "SCAN_PLANNING_MODE",
			"env_value": "client"
		}
	],
	"skip_tests": [
		{
			"reason": "The filesystem catalog test config uses a local warehouse, so tests that disable the local file system cannot write table files",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/create/test_create_local_fs_disabled.test"
			]
		},
		{
			"reason": "The test asserts the REST catalog's HTTP 409 conflict response; filesystem catalog conflicts are reported by the failed commit requirement",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_insert_multiple_transactions_retry_disabled.test"
			]
		},
		{
			"reason": "The test hard-codes the fixture catalog's initial field-ID order; the filesystem catalog preserves the client's valid field IDs",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/insert/test_unknown_type_omitted_from_data_files.test"
			]
		},
		{
			"reason": "The test asserts the HTTP requests of a REST catalog",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/iceberg_catalog_eager_refresh.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/delete_table.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_etag.test"
			]
		},
		{
			"reason": "The filesystem catalog test config uses a local warehouse, so HTTP file-read assertions do not apply",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/delete/test_no_head_request_for_deletes.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_delete_manifest_filter_pushdown.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/partitioned_reads_v3/test_partitioned_reads_v3.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/partitioning/test_partitioning_pushdown_bucket.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_data_manifest_late_materialization.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/partitioned_reads/test_in_filter_partition_pruning.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/test_requests_to_partitioned_table.test"
			]
		},
		{
			"reason": "Filesystem catalogs don't support renaming tables: a table's directory and the paths in its metadata would all have to change",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/rename_table/create_and_rename.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/rename_table/rename_preserves_metadata.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/rename_table/rename_table_after_modifications.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/rename_table/rename_table_test.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/rename_table/rename_then_scan_catalog.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/transactions/concurrent_table_swap.test"
			]
		},
		{
			"reason": "The test asserts the REST catalog's error message; a filesystem catalog rejects namespace property changes at commit",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/capabilities/no_namespace_properties.test"
			]
		}
	]
}
