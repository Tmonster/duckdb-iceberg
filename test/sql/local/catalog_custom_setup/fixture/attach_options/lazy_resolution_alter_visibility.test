# name: test/sql/local/catalog_custom_setup/fixture/attach_options/lazy_resolution_alter_visibility.test
# description: with TABLE_RESOLUTION 'lazy', a column added by ALTER must be visible to a later DESCRIBE
# group: [attach_options]

require-env FIXTURE_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
set enable_logging=true

statement ok
set logging_level='debug';

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);

# ---------------------------------------------------------------------------
# setup: create the table this test needs, so it does not depend on generated
# fixture data
# ---------------------------------------------------------------------------

statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181',
    TABLE_RESOLUTION 'lazy'
);

statement ok
DROP TABLE IF EXISTS my_datalake.tra.tra_probe;

statement ok
DROP SCHEMA IF EXISTS my_datalake.tra;

statement ok
CREATE SCHEMA my_datalake.tra;

statement ok
CREATE TABLE my_datalake.tra.tra_probe (id BIGINT, name VARCHAR);

statement ok
INSERT INTO my_datalake.tra.tra_probe SELECT range, 'v' || range::VARCHAR FROM range(10);

# ---------------------------------------------------------------------------
# re-attach so the catalog starts with nothing resolved, then read, alter, and
# describe. The DESCRIBE must reflect the ALTER that this same connection just
# committed.
# ---------------------------------------------------------------------------

statement ok
DETACH my_datalake;

statement ok
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181',
    TABLE_RESOLUTION 'eager'
);

# resolve the table by reading it
query I
SELECT count(*) FROM my_datalake.tra.tra_probe;
----
10

query II
SELECT column_name, column_type FROM (DESCRIBE my_datalake.tra.tra_probe);
----
id	BIGINT
name	VARCHAR

statement ok
ALTER TABLE my_datalake.tra.tra_probe ADD COLUMN extra DOUBLE;

# the column just added must show up here
query II
SELECT column_name, data_type FROM information_schema.columns where table_name = 'tra_probe' and table_schema = 'tra' and table_catalog = 'my_datalake';
----
id	BIGINT
name	VARCHAR
extra	DOUBLE

# and it must be selectable
query III
SELECT id, name, extra FROM my_datalake.tra.tra_probe WHERE id = 0;
----
0	v0	NULL

# ---------------------------------------------------------------------------
# cleanup
# ---------------------------------------------------------------------------

statement ok
DROP TABLE my_datalake.tra.tra_probe;

statement ok
DROP SCHEMA my_datalake.tra;

statement ok
DETACH my_datalake;
