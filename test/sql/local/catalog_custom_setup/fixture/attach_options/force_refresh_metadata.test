# name: test/sql/local/catalog_custom_setup/fixture/attach_options/force_refresh_metadata.test
# description: test iceberg_force_refresh_metadata()
# group: [attach_options]

require-env FIXTURE_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
set enable_logging=true

statement ok
set logging_level='debug';

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);

statement error
SELECT * FROM iceberg_force_refresh_metadata('not_attached');
----
<REGEX>:.*No database named 'not_attached' is attached.*

statement error
SELECT * FROM iceberg_force_refresh_metadata('memory');
----
<REGEX>:.*only works on an Iceberg catalog.*

# ---------------------------------------------------------------------------
# setup: this test creates the tables it needs, so it does not depend on
# generated fixture data
# ---------------------------------------------------------------------------

statement ok
ATTACH '' AS reader (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181',
    TABLE_RESOLUTION 'eager'
);

# a second handle on the same catalog, standing in for an external writer
statement ok
ATTACH '' AS writer (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    URI 'http://127.0.0.1:8181'
);

statement ok
DROP TABLE IF EXISTS writer.frm.frm_probe;

statement ok
DROP SCHEMA IF EXISTS writer.frm;

statement ok
CREATE SCHEMA writer.frm;

statement ok
CREATE TABLE writer.frm.frm_probe (id BIGINT);

# ---------------------------------------------------------------------------
# a listing pins the schema it first resolved
# ---------------------------------------------------------------------------

query II
SELECT table_name, column_name FROM information_schema.columns
WHERE table_catalog = 'reader' AND table_schema = 'frm';
----
frm_probe	id

# an external writer alters the table; 'reader' does not notice
statement ok
ALTER TABLE writer.frm.frm_probe ADD COLUMN extra DOUBLE;

query II
SELECT table_name, column_name FROM information_schema.columns
WHERE table_catalog = 'reader' AND table_schema = 'frm';
----
frm_probe	id

# ---------------------------------------------------------------------------
# the refresh makes it notice
# ---------------------------------------------------------------------------

query III
SELECT schema_name, table_name, refreshed FROM iceberg_force_refresh_metadata('reader')
WHERE schema_name = 'frm';
----
frm	frm_probe	true

# nothing in this test's own schema failed. Deliberately not asserted over the whole catalog: a
# shared fixture can hold tables the catalog lists but whose metadata is gone from storage, and
# those legitimately report refreshed = false with the error explaining why.
query I
SELECT count(*) FROM iceberg_force_refresh_metadata('reader')
WHERE schema_name = 'frm' AND NOT refreshed;
----
0

query III
SELECT table_name, column_name, data_type FROM information_schema.columns
WHERE table_catalog = 'reader' AND table_schema = 'frm'
ORDER BY ordinal_position;
----
frm_probe	id	BIGINT
frm_probe	extra	DOUBLE

# ---------------------------------------------------------------------------
# the refresh also picks up tables created and dropped elsewhere
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE writer.frm.frm_second (x VARCHAR);

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('HTTP');

query III
SELECT schema_name, table_name, refreshed FROM iceberg_force_refresh_metadata('reader')
WHERE schema_name = 'frm' ORDER BY table_name;
----
frm	frm_probe	true
frm	frm_second	true

# the refresh re-resolves, and does so without vending storage credentials
query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/tables/frm_%' AND request.url NOT LIKE '%snapshots=refs';
----
0

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/tables/frm_%'
  AND contains(map_keys(request.headers), 'X-Iceberg-Access-Delegation');
----
0

statement ok
DROP TABLE writer.frm.frm_second;

query III
SELECT schema_name, table_name, refreshed FROM iceberg_force_refresh_metadata('reader')
WHERE schema_name = 'frm' ORDER BY table_name;
----
frm	frm_probe	true

# ---------------------------------------------------------------------------
# a refreshed table is still only resolved for listing: reading it takes a
# full load, with credential vending
# ---------------------------------------------------------------------------

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM reader.frm.frm_probe;
----
0

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%/tables/frm_probe'
  AND contains(map_keys(request.headers), 'X-Iceberg-Access-Delegation');
----
1

# ---------------------------------------------------------------------------
# cleanup
# ---------------------------------------------------------------------------

statement ok
DROP TABLE writer.frm.frm_probe;

statement ok
DROP SCHEMA writer.frm;

statement ok
DETACH reader;

statement ok
DETACH writer;
