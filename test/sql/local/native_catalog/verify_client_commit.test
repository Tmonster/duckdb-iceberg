# name: test/sql/local/native_catalog/verify_client_commit.test
# description: iceberg_verify_client_commit applies each REST commit client-side and compares it to the catalog's result
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
SET iceberg_verify_client_commit = true;

statement ok
CREATE TABLE my_datalake.default.verify_v2 (a INT, b VARCHAR) WITH ('format-version' = '2');

statement ok
INSERT INTO my_datalake.default.verify_v2 VALUES (1, 'one'), (2, 'two');

# The verifier loads the table's committed state before sending the commit
statement ok
CALL enable_logging('HTTP');

statement ok
INSERT INTO my_datalake.default.verify_v2 VALUES (3, 'three');

statement ok
CALL disable_logging();

query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('HTTP')
WHERE request.type = 'GET' AND request.url LIKE '%/tables/verify_v2';
----
true

# Schema evolution, deletes, updates and property changes
statement ok
ALTER TABLE my_datalake.default.verify_v2 ADD COLUMN c BIGINT;

statement ok
INSERT INTO my_datalake.default.verify_v2 VALUES (4, 'four', 40);

statement ok
DELETE FROM my_datalake.default.verify_v2 WHERE a = 1;

statement ok
UPDATE my_datalake.default.verify_v2 SET b = 'TWO' WHERE a = 2;

statement ok
ALTER TABLE my_datalake.default.verify_v2 SET ('verify.property' = 'x');

statement ok
ALTER TABLE my_datalake.default.verify_v2 RESET ('verify.property');

query ITI
SELECT * FROM my_datalake.default.verify_v2 ORDER BY a;
----
2	TWO	NULL
3	three	NULL
4	four	40

# v3 row lineage, partitioning and sorting
statement ok
CREATE TABLE my_datalake.default.verify_v3 (id BIGINT, part VARCHAR) WITH ('format-version' = '3');

statement ok
ALTER TABLE my_datalake.default.verify_v3 SET PARTITIONED BY (part);

statement ok
ALTER TABLE my_datalake.default.verify_v3 SET SORTED BY (id DESC);

statement ok
INSERT INTO my_datalake.default.verify_v3 SELECT range, 'p' || (range % 3) FROM range(30);

statement ok
DELETE FROM my_datalake.default.verify_v3 WHERE id % 2 = 0;

query I
SELECT count(*) FROM my_datalake.default.verify_v3;
----
15

# A table created and filled in one transaction, and two tables committed atomically
statement ok
BEGIN;

statement ok
CREATE TABLE my_datalake.default.verify_ctas AS SELECT range AS x FROM range(5);

statement ok
COMMIT;

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.verify_v2 VALUES (5, 'five', 50);

statement ok
INSERT INTO my_datalake.default.verify_ctas VALUES (5);

statement ok
COMMIT;

query II
SELECT (SELECT count(*) FROM my_datalake.default.verify_v2), (SELECT count(*) FROM my_datalake.default.verify_ctas);
----
4	6

# A catalog that reports success without applying the commit is caught
statement ok
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'POST', 'path', '/v1/transactions/commit', 'status', 204, 'body', NULL)::VARCHAR);

statement error
INSERT INTO my_datalake.default.verify_v2 VALUES (6, 'six', 60);
----
differs from the catalog's result

statement ok
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);

# The client-side commit rejects metadata whose partition spec refers to a dropped column, like a catalog server.
# con2 partitions by b, con1 drops b; the catalog is scripted to accept con1's commit anyway.
statement ok
CREATE TABLE my_datalake.default.verify_spec (a INT, b INT);

statement ok
INSERT INTO my_datalake.default.verify_spec VALUES (1, 10);

statement ok con1
SET iceberg_verify_client_commit = true;

statement ok con1
BEGIN;

statement ok con2
BEGIN;

statement ok con2
ALTER TABLE my_datalake.default.verify_spec SET PARTITIONED BY (b);

statement ok con2
COMMIT;

statement ok con1
ALTER TABLE my_datalake.default.verify_spec DROP COLUMN b;

statement ok
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'POST', 'path', '/v1/transactions/commit', 'status', 204, 'body', NULL)::VARCHAR);

statement error con1
COMMIT;
----
<REGEX>:.*accepted a commit .* that the client-side commit rejected: .*partition spec .* not in the current schema.*

statement ok
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);

statement ok
DROP TABLE my_datalake.default.verify_spec;

statement ok
SET iceberg_verify_client_commit = false;

statement ok
DROP TABLE my_datalake.default.verify_v2;

statement ok
DROP TABLE my_datalake.default.verify_v3;

statement ok
DROP TABLE my_datalake.default.verify_ctas;
