# name: test/sql/test_credential_refresh.test
# group: [lakekeeper]


require httpfs

require avro

require parquet

require iceberg

require-env LAKEKEEPER_SERVER_AVAILABLE

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
create secret my_secret (TYPE ICEBERG,CLIENT_ID 'spark',CLIENT_SECRET '2OR3eRvYfSZzzZ16MlPd95jhLnOaLM52',OAUTH2_SCOPE 'lakekeeper',OAUTH2_SERVER_URI 'http://localhost:30080/realms/iceberg/protocol/openid-connect/token'); 

statement ok
attach 'demo' as my_datalake (type ICEBERG,ENDPOINT 'http://localhost:8181/catalog',SECRET 'my_secret');

statement ok
Create schema if not exists my_datalake.default;


# refresh required on handle init
statement ok
set refresh_required_on_init=true;

# no error, Iceberg can refresh on init
statement ok
select * from my_datalake.my_namespace.my_table;

